    srcs: [
        ":jemalloc5_integrationtests_gtestified_srcs",
    ],

    static_libs: [
        "libjemalloc5_integrationtest",
        "libgtestifier",
    ],

    target: {
        linux_glibc: {
            // The sanitizer does not work for these tests on the host.
            sanitize: {
                never: true,
            },
        },
    },

    // Needed for basic.cpp test.
    stl: "libc++_static",
}

