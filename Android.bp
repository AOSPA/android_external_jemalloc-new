    output_extension: "c",
}

cc_test {
    name: "jemalloc5_integrationtests",

    defaults: ["jemalloc5_defaults"],

    cflags: common_cflags + [
        "-DJEMALLOC_INTEGRATION_TEST",
        "-DJEMALLOC_NO_RENAME",
        "-include jemalloc_gtest.h",
